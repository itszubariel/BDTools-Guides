{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/http", "dest": "/http/web/index.html" },
    { "src": "/http/([^/]+\\.[^/]+)", "dest": "/http/web/$1" },
    { "src": "/http/([^/]+)/([^/]+)", "dest": "/http/web/$1/$2" },

    { "src": "/compv2", "dest": "/compv2/web/index.html" },
    { "src": "/compv2/([^/]+\\.[^/]+)", "dest": "/compv2/web/$1" },
    { "src": "/compv2/([^/]+)/([^/]+)", "dest": "/compv2/web/$1/$2" },

    { "src": "/textsplit", "dest": "/textsplit/web/index.html" },
    { "src": "/textsplit/([^/]+\\.[^/]+)", "dest": "/textsplit/web/$1" },
    { "src": "/textsplit/([^/]+)/([^/]+)", "dest": "/textsplit/web/$1/$2" },

    { "src": "/json", "dest": "/json/web/index.html" },
    { "src": "/json/([^/]+\\.[^/]+)", "dest": "/json/web/$1" },
    { "src": "/json/([^/]+)/([^/]+)", "dest": "/json/web/$1/$2" }
  ]
}
