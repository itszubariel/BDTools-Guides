{
  "redirects": [
    { "source": "/http", "destination": "/http/", "permanent": false },
    { "source": "/compv2", "destination": "/compv2/", "permanent": false },
    { "source": "/textsplit", "destination": "/textsplit/", "permanent": false },
    { "source": "/json", "destination": "/json/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/http/", "destination": "/http-guide/web/index.html" },
    { "source": "/http/style.css", "destination": "/http-guide/web/style.css" },
    { "source": "/http/script.js", "destination": "/http-guide/web/script.js" },
    { "source": "/http/:category/:page", "destination": "/http-guide/web/:category/:page.html" },

    { "source": "/compv2/", "destination": "/compv2-guide/web/index.html" },
    { "source": "/compv2/style.css", "destination": "/compv2-guide/web/style.css" },
    { "source": "/compv2/script.js", "destination": "/compv2-guide/web/script.js" },
    { "source": "/compv2/images/:img", "destination": "/compv2-guide/web/images/:img" },
    { "source": "/compv2/:category/:page", "destination": "/compv2-guide/web/:category/:page.html" },

    { "source": "/textsplit/", "destination": "/textsplit-guide/web/index.html" },
    { "source": "/textsplit/style.css", "destination": "/textsplit-guide/web/style.css" },
    { "source": "/textsplit/script.js", "destination": "/textsplit-guide/web/script.js" },
    { "source": "/textsplit/:category/:page", "destination": "/textsplit-guide/web/:category/:page.html" },

    { "source": "/json/", "destination": "/json-guide/web/index.html" },
    { "source": "/json/style.css", "destination": "/json-guide/web/style.css" },
    { "source": "/json/script.js", "destination": "/json-guide/web/script.js" },
    { "source": "/json/:category/:page", "destination": "/json-guide/web/:category/:page.html" }
  ]
}
